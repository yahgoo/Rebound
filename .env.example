# Atlas sandbox API
ATLAS_BASE_URL=https://sandbox.atriptech.com
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# Hard spend ceiling in SGD (Guardian; never model-writable)
GUARDIAN_MAX_SPEND_SGD=800

# Mode switches
REBOUND_MODE=live
EXECUTOR=local
CHAOS_PROFILE=none
SURFACE=operator
DAYTONA_TARGET_SANDBOXES=8
MODEL_ROUTER_DEFAULT=gemini

# Model backends (optional until Interpreter / Caretaker)
GEMINI_API_KEY=
# Optional transport override for ModelBackend.GEMINI: unset = direct google-genai;
# set to openrouter to use OpenRouter PAYGO (requires OPENROUTER_API_KEY).
GEMINI_VIA=
OPENROUTER_API_KEY=
GEMMA_ENDPOINT=
KIMI_API_KEY=

# Daytona (required only when EXECUTOR=daytona)
DAYTONA_API_KEY=

# Optional sovereign GPU path (off critical path)
NOSANA_API_KEY=

# Family notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_FAMILY_CHAT_ID=

# Operator console bearer token (no user accounts)
OPERATOR_TOKEN=

# Public origin for webhooks and traveller magic links
PUBLIC_BASE_URL=
